# ─────────────────────────────────────────────────────────────
#  متغیرهای محیطی برای Docker Compose  (این فایل را به .env کپی کنید)
#  cp .env.example .env   و سپس مقادیر را ویرایش کنید
# ─────────────────────────────────────────────────────────────

# رمز عبور کاربر پایگاه‌داده PostgreSQL (حتماً تغییر دهید)
DB_PASSWORD=ChangeMe_Strong_DB_Password

# کلید امضای توکن‌های JWT — باید یک رشته تصادفی و بلند باشد
# تولید مقدار امن:  openssl rand -hex 32
KPI_SECRET_KEY=replace-with-openssl-rand-hex-32
